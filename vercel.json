      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"agazaty-android-v1.3.7.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/apk",
      "destination": "/agazaty-android-v1.3.7.apk",
      "permanent": false
    },
    {

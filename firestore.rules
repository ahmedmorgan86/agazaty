rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.get('email', '') == 'ahmed.morgan2009@gmail.com' && (request.auth.token.get('admin', false) == true
        || (exists(/databases/$(database)/documents/ownerAccess/$(request.auth.uid))
          && get(/databases/$(database)/documents/ownerAccess/$(request.auth.uid)).data.role == 'admin'));
    }
    function profile() {
      return get(/databases/$(database)/documents/employeeAccounts/$(request.auth.uid)).data;
    }
    function isEmployee() {
      return request.auth != null && exists(/databases/$(database)/documents/employeeAccounts/$(request.auth.uid));
    }
    function sameGroup(key) {
      return isEmployee() && key == profile().get('groupKey', profile().team + '|' + profile().job);
    }
    function allowedJob(job) {
      return job is string && job.size() > 0 && job.size() <= 80 && job.matches('^[^/]+$')
        && exists(/databases/$(database)/documents/jobs/$(job))
        && get(/databases/$(database)/documents/jobs/$(job)).data.active == true;
    }
    function validMemberEdit() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'annual_balance', 'casual_balance', 'perm_hours'])
        && (!changed.hasAny(['name']) || (request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80))
        && (!changed.hasAny(['annual_balance']) || (request.resource.data.annual_balance is number
          && request.resource.data.annual_balance >= 0 && request.resource.data.annual_balance <= 365))
        && (!changed.hasAny(['casual_balance']) || (request.resource.data.casual_balance is number
          && request.resource.data.casual_balance >= 0 && request.resource.data.casual_balance <= 365))
        && (!changed.hasAny(['perm_hours']) || (request.resource.data.perm_hours is number
          && request.resource.data.perm_hours >= 0 && request.resource.data.perm_hours <= 100));
    }
    function validRecord(date, employeeId) {
      let target = get(/databases/$(database)/documents/teamMembership/$(employeeId)).data;
      return request.resource.data.keys().hasAll(['date', 'team', 'job', 'groupKey', 'status', 'delay', 'permissionMinutes', 'notes'])
        && request.resource.data.keys().hasOnly(['date', 'team', 'job', 'groupKey', 'status', 'delay', 'permissionMinutes', 'notes'])
        && date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && request.resource.data.date == date
        && request.resource.data.team == target.team
        && request.resource.data.job == target.job
        && request.resource.data.groupKey == target.groupKey
        && request.resource.data.status in ['حضور', 'راحة', 'إعتيادي', 'عارضة', 'إذن', 'مأمورية']
        && request.resource.data.delay is int && request.resource.data.delay >= 0 && request.resource.data.delay <= 1440
        && request.resource.data.permissionMinutes is int && request.resource.data.permissionMinutes >= 0 && request.resource.data.permissionMinutes <= 1440
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000;
    }
    match /ownerAccess/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /registrationRequests/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.get('email', '') == request.resource.data.code + '@accounts.shifts-attendance-am-2026.firebaseapp.com'
        && request.resource.data.keys().hasOnly(['name', 'code', 'team', 'job', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'code', 'team', 'job', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{4}$')
        && request.resource.data.code != '5686'
        && request.resource.data.team in ['red', 'blue', 'yellow', 'morning']
        && allowedJob(request.resource.data.job)
        && request.resource.data.status == 'pending' && request.resource.data.createdAt is string;
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }
    match /jobs/{name} {
      allow read: if true;
      allow create, update: if isAdmin() && name.size() > 0 && name.size() <= 80
        && request.resource.data.keys().hasOnly(['name', 'active'])
        && request.resource.data.name == name && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }
    match /employeeAccounts/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid && validMemberEdit())
        || (sameGroup(resource.data.groupKey) && validMemberEdit());
    }
    match /teamMembership/{employeeId} {
      allow read, write: if isAdmin();
    }
    match /staff/{employeeId} {
      allow get, list: if isAdmin()
        || sameGroup(resource.data.groupKey)
        || (request.auth != null && (employeeId == request.auth.uid || resource.data.get('authUid', '') == request.auth.uid));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && (
        (employeeId == request.auth.uid || resource.data.get('authUid', '') == request.auth.uid
          || resource.data.get('id', '') == request.auth.uid || sameGroup(resource.data.groupKey))
        && validMemberEdit()
      ));
    }
    match /meta/workspace {
      allow read: if isAdmin() || isEmployee();
      allow create, update: if isAdmin();
      allow delete: if false;
    }
    match /{path=**}/records/{employeeId} {
      allow get, list: if isAdmin() || sameGroup(resource.data.groupKey);
    }
    match /attendance/{date}/records/{employeeId} {
      allow create, update: if isAdmin() || (sameGroup(request.resource.data.groupKey) && validRecord(date, employeeId));
      allow delete: if isAdmin() || (isEmployee() && sameGroup(resource.data.groupKey)
        && get(/databases/$(database)/documents/teamMembership/$(employeeId)).data.groupKey == profile().get('groupKey', profile().team + '|' + profile().job));
    }
    // Legacy data is available only to admins for one-time migration.
    match /shared/workspace {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every visitor signs in anonymously without a visible login form.
    match /shared/workspace {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['employees', 'attendanceData'])
        && request.resource.data.keys().hasOnly(['employees', 'attendanceData', 'updatedAt'])
        && request.resource.data.employees is list
        && request.resource.data.attendanceData is map;
      allow delete: if false;
    }
  }
}
